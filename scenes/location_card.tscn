[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/location_card.gd" id="1_script"]

[node name="LocationCard" type="PanelContainer"]
theme_type_variation = &"CityCard"
script = ExtResource("1_script")

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Header" type="Button" parent="Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 150)
layout_mode = 2
flat = true

[node name="Row" type="HBoxContainer" parent="Box/Header"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 16

[node name="Names" type="VBoxContainer" parent="Box/Header/Row"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
mouse_filter = 2
theme_override_constants/separation = 0

[node name="PlaceName" type="Label" parent="Box/Header/Row/Names"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"

[node name="PlaceState" type="Label" parent="Box/Header/Row/Names"]
unique_name_in_owner = true
layout_mode = 2

[node name="People" type="HBoxContainer" parent="Box/Header/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Body" type="VBoxContainer" parent="Box"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 18

[node name="Description" type="Label" parent="Box/Body"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="Actions" type="VBoxContainer" parent="Box/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 16
