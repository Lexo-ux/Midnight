          "actor": "sazil",
          "label": "Hablar con Marcos",
          "lines": [
            { "speaker": "marcos", "text": "Buenas tardes. ¿Usted reparte por aquí? Entonces sabrá quién vende periódicos que aciertan." },
            { "speaker": "sazil", "text": "¿Beto? Acierta lo mismo que el horóscopo." },
            { "speaker": "marcos", "text": "Eso dicen todos. Hasta que deja de ser broma. Gracias, ha sido muy amable." },
            { "speaker": "sazil", "text": "Sonríe, da las gracias y no suelta nada más. Con él, la puerta está cerrada." }
          ],
          "effects": { "clues": [ "hecho_marcos_sospecha", "hecho_llegada_marcos" ] },
          "provisional": true
        },
        {
          "id": "marcos_akba",
          "actor": "akba",
          "label": "Hablar con Marcos",
          "lines": [
            { "speaker": "marcos", "text": "Usted huele a madrugada." },
            { "speaker": "akba", "text": "Trabajo de noche." },
            { "speaker": "marcos", "text": "Lo sé. Yo también. Que tenga buena tarde." },
            { "speaker": "akba", "text": "Ni una rendija por donde entrar. Su puerta está cerrada." }
          ],
          "effects": { "clues": [ "rumor_cazadores" ] },
          "provisional": true
        }
      ],
      "velo3": null
